# Copy to .env.local and fill in. .env.local is gitignored.
#
# DEPLOYING? Every variable below marked "required" must also be set in your
# host's environment settings (Vercel: Project -> Settings -> Environment
# Variables). They are NOT read from this file or from .env.local in production.
# After deploying, open https://<your-domain>/api/health — it reports exactly
# which of these are missing and whether the database is reachable.

# ---- Front-end mode -------------------------------------------------
# true  = run the whole UI off src/mock/data.ts, no network, no database.
#         Use this while redesigning the front-end.
# false / unset = hit the real route handlers in src/app/api.
#
# This is inlined at BUILD time, not read at runtime, so changing it on the
# host requires a redeploy. Never set it to true in production — the site would
# show fixtures and never call the API.
NEXT_PUBLIC_USE_MOCK=false

# ---- Database (required) --------------------------------------------
# The deployed app must also be allowed through the database firewall.
# In MongoDB Atlas: Network Access -> add 0.0.0.0/0. Serverless hosts do not
# have a fixed outbound IP, so an allow-list of your home IP will work locally
# and time out in production — the single most common cause of "the API works
# on my machine but not on the live site".
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/foodbox

# ---- Auth (required) ------------------------------------------------
# Signs both user and admin JWTs. Use a long random string.
# If this differs between environments, tokens issued by one are rejected by
# the other and every logged-in user is bounced to /login.
JWT_SECRET=
JWT_EXPIRE=30d

# ---- One-time setup -------------------------------------------------
# Required by POST /api/setup and POST /api/setup/admin, sent as the
# x-setup-secret header. Leave unset in production once seeding is done —
# without it both endpoints return 503.
SETUP_SECRET=
