# Copy to .env.local and fill in. .env.local is gitignored.

# ---- Front-end mode -------------------------------------------------
# true  = run the whole UI off src/mock/data.ts, no network, no database.
#         Use this while redesigning the front-end.
# unset = hit the real route handlers in src/app/api.
NEXT_PUBLIC_USE_MOCK=true

# ---- Database -------------------------------------------------------
# Required unless NEXT_PUBLIC_USE_MOCK=true.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/foodbox

# ---- Auth -----------------------------------------------------------
# Signs both user and admin JWTs. Use a long random string.
JWT_SECRET=
JWT_EXPIRE=30d

# ---- One-time setup -------------------------------------------------
# Required by POST /api/setup and POST /api/setup/admin, sent as the
# x-setup-secret header. Leave unset in production once seeding is done —
# without it both endpoints return 503.
SETUP_SECRET=
